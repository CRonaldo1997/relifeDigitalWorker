# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Backup and temporary files
*.bak
*.swp
*.swo

# Logs
*.log

# Archive directory (pre-git backups, kept on disk but not tracked)
archive/

# Local environment and secrets (but keep the example template)
.env
.env.*
!.env.example
.claude/
CLAUDE.md
AGENTS.md
.cursorrules
.windsurfrules
.aider*
copilot-instructions.md

# Generated screenshots and transient artifacts
screenshot-*.png
full-UI.png

# Version file written by Docker/CI build — generated, never committed
api/_version.py

# OS files
.DS_Store
Thumbs.db

# Docker related
Dockerfile
docker-compose*.yml
.dockerignore
docker_init.bash

# Development/Redundant Documentation
ARCHITECTURE.md
CHANGELOG.md
CONTRIBUTING.md
HERMES.md
ROADMAP.md
SPRINTS.md
TESTING.md
THEMES.md

# Local reference clones — never committed (except tracked design/UI-UX reference pages)
docs/*
!docs/ui-ux/
!docs/ui-ux/**
!docs/optimization-checklist.md

# Tests / scratch / CI / dev helpers — excluded from runtime distribution
tests/
scratch*.py
start.sh
.github/
